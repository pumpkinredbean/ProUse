{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved workspace and worker profile registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workspaces",
    "worker_profiles",
    "model_capabilities",
    "default_worker_profile"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "server_name": {
      "type": "string",
      "minLength": 1
    },
    "default_workspace_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "default_worker_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "codex_bin": {
      "type": "string",
      "minLength": 1
    },
    "workspaces": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "root",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "default_worker_profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "context_policy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "worker_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "model",
          "reasoning_effort"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,119}$"
          },
          "reasoning_effort": {
            "enum": [
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          },
          "access": {
            "enum": [
              "full_access",
              "workspace_sandbox"
            ]
          }
        }
      }
    },
    "model_capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        }
      }
    }
  }
}
